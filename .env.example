# Advanced Web Scraper Environment Configuration
SCRAPER_ENGINE=http
SCRAPER_CONCURRENCY=5
SCRAPER_DELAY=0.5
SCRAPER_TIMEOUT=20.0
SCRAPER_MAX_RETRIES=3

# Anti-Detection & Proxies
SCRAPER_USER_AGENT_ROTATION=true
# PROXIES=http://user:pass@proxy1:port,http://user:pass@proxy2:port

# Caching
CACHE_ENABLED=false
CACHE_DIR=.cache
CACHE_TTL_SECONDS=3600

# UI Server
UI_HOST=0.0.0.0
UI_PORT=8000


# ---------------------------------------------------------------------------
# PostgreSQL
# ---------------------------------------------------------------------------
POSTGRES_USER=scraper
POSTGRES_PASSWORD=scraper
POSTGRES_DB=scraper
POSTGRES_PORT=5432

# Async SQLAlchemy DSN.
#   local development : postgresql+asyncpg://scraper:scraper@localhost:5432/scraper
#   docker compose    : postgresql+asyncpg://scraper:scraper@db:5432/scraper (injected)
DATABASE_URL=postgresql+asyncpg://scraper:scraper@localhost:5432/scraper

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
APP_PORT=8000
SCRAPER_ENGINE=http
SCRAPER_CONCURRENCY=5
SCRAPER_DELAY=0.5
SCRAPER_TIMEOUT=20.0
SCRAPER_MAX_RETRIES=3
SCRAPER_USER_AGENT_ROTATION=true
CACHE_ENABLED=false
CACHE_DIR=.cache
CACHE_TTL_SECONDS=3600
UI_HOST=0.0.0.0
UI_PORT=8000
